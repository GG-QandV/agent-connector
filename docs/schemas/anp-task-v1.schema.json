{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/GG-QandV/agent-connector/docs/schemas/anp-task-v1.schema.json",
  "title": "agent-connector.anp-task.v1",
  "description": "Application-level task profile transported inside ANP direct.send / direct.incoming payloads. This schema is owned by agent-connector, not by upstream ANP.",
  "type": "object",
  "required": ["profile", "message_type", "task_id", "operation_id", "message_id", "payload"],
  "additionalProperties": false,
  "properties": {
    "profile": {
      "const": "agent-connector.anp-task.v1"
    },
    "message_type": {
      "type": "string",
      "enum": [
        "task.invoke",
        "task.accepted",
        "task.get_status",
        "task.cancel",
        "task.input_required",
        "task.provide_input",
        "task.progress",
        "task.artifact",
        "task.events",
        "task.completed",
        "task.failed",
        "task.cancelled"
      ]
    },
    "task_id": {
      "type": "string",
      "format": "uuid",
      "description": "Local canonical task identifier owned by AdapterCore."
    },
    "remote_task_id": {
      "type": ["string", "null"],
      "description": "Peer-assigned task identifier, correlation metadata only. Never used as the canonical TaskId."
    },
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Stable idempotency key reused across retries of the same logical invoke. Maps 1:1 to InvokeRequest.idempotency_key."
    },
    "message_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for this specific message delivery. Must differ between retries of the same operation_id."
    },
    "causation_id": {
      "type": ["string", "null"],
      "format": "uuid",
      "description": "message_id of the message that caused this one (e.g. task.cancel causing task.cancelled)."
    },
    "seq": {
      "type": ["integer", "null"],
      "minimum": 1,
      "description": "Monotonic, durable, per-task sequence number. Required for task.progress, task.artifact, task.input_required, task.completed, task.failed, task.cancelled, task.accepted. Must be null for task.invoke, task.get_status, task.cancel, task.provide_input, task.events (request direction)."
    },
    "after_seq": {
      "type": ["integer", "null"],
      "minimum": 0,
      "description": "Only present on task.events requests: resume cursor. Peer must return all durable events with seq > after_seq, then live events."
    },
    "final": {
      "type": "boolean",
      "default": false,
      "description": "True only on task.completed, task.failed, task.cancelled. Once true for a task_id, no further message with the same task_id may be accepted or emitted."
    },
    "payload": {
      "type": "object",
      "description": "message_type-specific body. See per-type definitions below (enforced by protocol-anp-profile validation, not by this generic schema)."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "message_type": { "const": "task.invoke" } }
      },
      "then": {
        "properties": {
          "seq": { "const": null },
          "after_seq": { "const": null },
          "final": { "const": false },
          "payload": {
            "type": "object",
            "required": ["input"],
            "properties": {
              "skill_id": { "type": ["string", "null"] },
              "session_id": { "type": ["string", "null"], "format": "uuid" },
              "input": { "type": "array" },
              "context": { "type": "object" },
              "deadline_ms": { "type": ["integer", "null"], "minimum": 1 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "message_type": { "const": "task.cancel" } }
      },
      "then": {
        "properties": {
          "seq": { "const": null },
          "after_seq": { "const": null },
          "final": { "const": false },
          "payload": {
            "type": "object",
            "properties": {
              "reason": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "message_type": { "const": "task.provide_input" } }
      },
      "then": {
        "properties": {
          "seq": { "const": null },
          "after_seq": { "const": null },
          "final": { "const": false },
          "payload": {
            "type": "object",
            "required": ["input"],
            "properties": {
              "input": { "type": "array" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "message_type": { "const": "task.get_status" } }
      },
      "then": {
        "properties": {
          "seq": { "const": null },
          "after_seq": { "const": null },
          "final": { "const": false },
          "payload": { "type": "object", "maxProperties": 0 }
        }
      }
    },
    {
      "if": {
        "properties": { "message_type": { "const": "task.events" } }
      },
      "then": {
        "required": ["after_seq"],
        "properties": {
          "seq": { "const": null },
          "final": { "const": false },
          "payload": { "type": "object", "maxProperties": 0 }
        }
      }
    },
    {
      "if": {
        "properties": { "message_type": { "const": "task.accepted" } }
      },
      "then": {
        "required": ["seq"],
        "properties": {
          "final": { "const": false },
          "payload": {
            "type": "object",
            "properties": {
              "queued": { "type": "boolean" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "message_type": { "const": "task.progress" } }
      },
      "then": {
        "required": ["seq"],
        "properties": {
          "final": { "const": false },
          "payload": {
            "type": "object",
            "required": ["message"],
            "properties": {
              "message": { "type": "string" },
              "percent": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "message_type": { "const": "task.artifact" } }
      },
      "then": {
        "required": ["seq"],
        "properties": {
          "final": { "const": false },
          "payload": {
            "type": "object",
            "required": ["id", "name", "mime_type", "size_bytes"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "mime_type": { "type": "string" },
              "size_bytes": { "type": "integer", "minimum": 0 },
              "uri": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "message_type": { "const": "task.input_required" } }
      },
      "then": {
        "required": ["seq"],
        "properties": {
          "final": { "const": false },
          "payload": {
            "type": "object",
            "required": ["request_id", "question"],
            "properties": {
              "request_id": {
                "type": "string",
                "description": "Stable identifier persisted in CoreEvent metadata; must not be regenerated on redelivery/replay."
              },
              "question": { "type": "string" },
              "schema": { "type": ["object", "null"] }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "message_type": { "const": "task.completed" } }
      },
      "then": {
        "required": ["seq"],
        "properties": {
          "final": { "const": true },
          "payload": {
            "type": "object",
            "required": ["output"],
            "properties": {
              "output": { "type": "array" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "message_type": { "const": "task.failed" } }
      },
      "then": {
        "required": ["seq"],
        "properties": {
          "final": { "const": true },
          "payload": {
            "type": "object",
            "required": ["code", "message", "retryable"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "retryable": { "type": "boolean" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "message_type": { "const": "task.cancelled" } }
      },
      "then": {
        "required": ["seq"],
        "properties": {
          "final": { "const": true },
          "payload": { "type": "object", "maxProperties": 0 }
        }
      }
    }
  ]
}
